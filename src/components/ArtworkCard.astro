---
import { asset } from '../data/media';
import type { Artwork } from '../data/media';

interface Props {
  piece: Artwork;
  index: number;
}

const { piece, index } = Astro.props;
const plateNumber = String(index + 1).padStart(2, '0');
const caption = [piece.medium, piece.year].filter(Boolean).join(' · ');
const alt = piece.alt ?? `${piece.title} — ${piece.categoryLabel} artwork by Lyrak`;
---

<figure
  class="piece group mb-6 break-inside-avoid sm:mb-10"
  data-category={piece.categorySlug}
  data-title={piece.title}
  data-caption={caption}
  data-video={piece.isVideo && piece.animation ? asset(piece.animation.src) : undefined}
  data-video-poster={piece.isVideo && piece.animation ? asset(piece.image) : undefined}
>
  <button
    type="button"
    class:list={[
      'plate block w-full text-left',
      piece.isVideo ? 'cursor-pointer' : 'cursor-zoom-in',
    ]}
    data-open={index}
    aria-label={piece.isVideo ? `Play ${piece.title}` : `View ${piece.title} full size`}
  >
    <span class="relative block overflow-hidden bg-paper-deep">
      <img
        class:list={[
          'block h-auto w-full transition-transform duration-500 ease-out',
          piece.isVideo ? 'group-hover:scale-[1.01]' : 'group-hover:scale-[1.02]',
        ]}
        src={asset(piece.image)}
        alt={alt}
        loading={index < 3 ? 'eager' : 'lazy'}
        decoding="async"
      />
      {
        piece.isVideo && (
          <span
            class="pointer-events-none absolute inset-0 flex items-center justify-center bg-ink/15 transition-colors group-hover:bg-ink/25"
            aria-hidden="true"
          >
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-paper/90 text-ink shadow-sm transition-transform group-hover:scale-105">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                <path d="M6.5 4.2v11.6c0 .5.55.8.98.53l9-5.8a.63.63 0 0 0 0-1.06l-9-5.8a.63.63 0 0 0-.98.53Z" />
              </svg>
            </span>
          </span>
        )
      }
    </span>
  </button>

  <figcaption class="mt-3 flex items-baseline gap-3">
    <span class="meta shrink-0 text-ink-faint tabular-nums">{plateNumber}</span>
    <span class="min-w-0 flex-1">
      <span class="block truncate text-[0.95rem] text-ink">{piece.title}</span>
      <span class="meta mt-1 block text-ink-faint">{caption || piece.categoryLabel}</span>
    </span>
  </figcaption>
</figure>

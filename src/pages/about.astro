---
import SiteLayout from '../layouts/SiteLayout.astro';
import { asset } from '../data/media';
---

<SiteLayout
  title="About"
  description="Meet Lyrak, a digital artist and 2D animator making expressive characters, painted worlds and small moments in motion."
>
  <article class="mx-auto max-w-[86rem] px-5 pt-12 sm:px-8 sm:pt-16 lg:px-12 lg:pt-24">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.78fr)] lg:gap-20">
      <div class="reveal">
        <p class="meta mb-5 text-accent">A little about me</p>
        <h1 class="display max-w-3xl text-page">I draw the moments<br class="hidden sm:block" /> that stay with you.</h1>

        <div class="mt-9 max-w-2xl space-y-5 text-[1.02rem] leading-[1.9] text-ink-soft">
          <p>
            Hello, I'm Lyra — a digital artist and 2D animator drawn to expressive characters, quiet stories and colour that carries a feeling.
          </p>
          <p>
            My work moves between softly rendered portraits, loose exploratory sketches and small loops that give a scene one more breath. I like the in-between: a look held for a second, fabric catching the wind, the last light on a face.
          </p>
          <p>
            This portfolio is an evolving collection of personal pieces and work made with clients. Thank you for spending a little time here.
          </p>
        </div>

        <div class="mt-11 border-t border-rule pt-6">
          <p class="meta text-ink-faint">What I make</p>
          <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sm text-ink-soft">
            <li>Character illustration</li>
            <li>2D animation</li>
            <li>Portraits &amp; fan art</li>
          </ul>
        </div>
      </div>

      <figure class="reveal lg:mt-12 [animation-delay:100ms]">
        <div class="overflow-hidden bg-paper-deep">
          <img
            class="block h-auto w-full"
            src={asset('images/Ceobe.png')}
            alt="A blonde character in a white animal-eared cap, arms outstretched against a teal background."
            loading="lazy"
          />
        </div>
        <figcaption class="mt-3 flex items-baseline justify-between gap-4 text-xs text-ink-faint">
          <span>From the sketchbook</span>
          <span>Illustration · 2025</span>
        </figcaption>
      </figure>
    </div>

    <div class="mt-20 border-t border-rule pt-7 sm:mt-28">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="meta text-ink-faint">The work, in five drawers</p>
          <p class="display mt-3 text-3xl">Find a particular kind of thing.</p>
        </div>
        <a class="meta inline-flex w-fit border-b border-ink pb-1 text-ink transition-colors hover:border-accent hover:text-accent" href={import.meta.env.BASE_URL}>
          Browse the portfolio
        </a>
      </div>
    </div>
  </article>
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { categories } from '../data/categories';
import { artworks } from '../data/media';

const featuredPieces = artworks.filter((piece) => piece.featured);
const pieces = [...featuredPieces, ...artworks.filter((piece) => !piece.featured)];
const description = 'Digital illustration and 2D animation by Lyrak. Browse lineless art, full renders, sketches, animation and previous commissions.';
---

<SiteLayout title="Lyrak" description={description}>
  <section class="mx-auto max-w-[86rem] px-5 pt-12 pb-8 sm:px-8 sm:pt-16 lg:px-12 lg:pt-24">
    <div class="grid items-end gap-8 lg:grid-cols-[1fr_22rem] lg:gap-16">
      <div class="reveal">
        <p class="meta mb-5 text-accent">A collection of recent work</p>
        <h1 class="display max-w-4xl text-display">Stories told in<br class="hidden sm:block" /> colour and motion.</h1>
      </div>
      <p class="reveal max-w-sm text-[0.98rem] leading-[1.8] text-ink-soft [animation-delay:120ms]">
        Digital illustration and 2D animation by Lyrak. A quiet space for painted worlds, small gestures and things in motion.
      </p>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-y border-rule py-4 sm:mt-16 sm:flex-row sm:items-center sm:justify-between">
      <p class="meta shrink-0 text-ink-faint" id="gallery-count" aria-live="polite">
        <span>{pieces.length}</span> {pieces.length === 1 ? 'piece' : 'pieces'}
      </p>
      <div class="-mx-1 flex gap-x-5 gap-y-2 overflow-x-auto px-1 pb-1 sm:flex-wrap sm:justify-end" role="group" aria-label="Filter artwork by category">
        <button
          type="button"
          class="filter-button meta relative shrink-0 py-1 text-ink transition-colors hover:text-accent"
          data-filter="all"
          aria-pressed="true"
        >
          All
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              class="filter-button meta relative shrink-0 py-1 text-ink-soft transition-colors hover:text-accent"
              data-filter={category.slug}
              aria-pressed="false"
            >
              {category.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-x-5 sm:grid-cols-2 sm:gap-x-7 lg:grid-cols-3 lg:gap-x-9 xl:grid-cols-4" id="gallery" aria-live="polite">
      {
        pieces.map((piece, index) => (
          <ArtworkCard piece={piece} index={index} />
        ))
      }
    </div>

    <p id="gallery-empty" class="hidden py-16 text-center text-ink-soft">
      Nothing in this collection yet. Try another category.
    </p>

    <div class="mt-5 flex flex-col gap-3 border-t border-rule pt-5 text-xs leading-relaxed text-ink-faint sm:flex-row sm:items-center sm:justify-between">
      <p>Selected studies from 2024–25.</p>
      <p>All works © Lyrak. Please do not repost or train on my work.</p>
    </div>
  </section>

  <dialog class="lightbox m-auto max-h-[92dvh] max-w-[min(94vw,100rem)] overflow-visible bg-transparent p-0" aria-label="Artwork viewer">
    <div class="relative flex max-h-[92dvh] flex-col items-center">
      <button
        type="button"
        class="absolute -top-11 right-0 flex min-h-10 min-w-10 items-center justify-center border border-white/30 bg-black/40 text-white transition-colors hover:bg-white/15"
        data-close
        aria-label="Close artwork viewer"
        autofocus
      >
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 20 20" fill="none">
          <path d="m4 4 12 12M16 4 4 16" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
      <img class="max-h-[82dvh] max-w-[min(94vw,100rem)] object-contain" data-lightbox-image alt="" />
      <video class="hidden max-h-[82dvh] max-w-[min(94vw,100rem)] object-contain" data-lightbox-video muted loop playsinline></video>
      <p class="mt-3 text-center text-sm text-white/70" data-lightbox-caption></p>
    </div>
  </dialog>

  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.piece'));
    const count = document.querySelector<HTMLElement>('#gallery-count');
    const empty = document.querySelector<HTMLElement>('#gallery-empty');
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
    const lightboxImage = document.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const lightboxVideo = document.querySelector<HTMLVideoElement>('[data-lightbox-video]');
    const lightboxCaption = document.querySelector<HTMLElement>('[data-lightbox-caption]');

    function selectFilter(selected: HTMLButtonElement) {
      const filter = selected.dataset.filter;
      let visible = 0;

      for (const button of buttons) {
        const active = button === selected;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('text-ink', active);
        button.classList.toggle('text-ink-soft', !active);
        const underline = button.querySelector('[data-filter-underline]');
        if (active && !underline) {
          const line = document.createElement('span');
          line.dataset.filterUnderline = '';
          line.className = 'absolute inset-x-0 -bottom-1 h-px bg-accent';
          line.setAttribute('aria-hidden', 'true');
          button.append(line);
        } else if (!active && underline) {
          underline.remove();
        }
      }

      for (const card of cards) {
        const show = filter === 'all' || card.dataset.category === filter;
        card.hidden = !show;
        if (show) visible++;
      }

      if (count) {
        const noun = visible === 1 ? 'piece' : 'pieces';
        count.innerHTML = `<span>${visible}</span> ${noun}`;
      }
      empty?.classList.toggle('hidden', visible !== 0);
    }

    for (const button of buttons) {
      button.addEventListener('click', () => selectFilter(button));
    }

    // Use the animation's source in the viewer; stills open at their image size.
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-open]')) {
      button.addEventListener('click', () => {
        const card = button.closest<HTMLElement>('.piece');
        const video = card?.querySelector<HTMLVideoElement>('video');
        const image = card?.querySelector<HTMLImageElement>('img');
        if (!dialog || !lightboxImage || !lightboxVideo || (!video && !image)) return;

        if (video) {
          lightboxImage.classList.add('hidden');
          lightboxVideo.classList.remove('hidden');
          lightboxVideo.src = video.currentSrc || video.src;
          lightboxVideo.poster = video.poster;
          lightboxVideo.setAttribute('aria-label', video.getAttribute('aria-label') ?? 'Animated artwork');
          void lightboxVideo.play();
        } else if (image) {
          lightboxVideo.pause();
          lightboxVideo.removeAttribute('src');
          lightboxVideo.classList.add('hidden');
          lightboxImage.classList.remove('hidden');
          lightboxImage.src = image.currentSrc || image.src;
          lightboxImage.alt = image.alt;
        }

        if (lightboxCaption) {
          lightboxCaption.textContent = [card?.dataset.title, card?.dataset.caption].filter(Boolean).join(' — ');
        }
        dialog.showModal();
        dialog.querySelector<HTMLButtonElement>('[data-close]')?.focus();
      });
    }

    dialog?.querySelector<HTMLButtonElement>('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog?.addEventListener('close', () => {
      if (lightboxImage) {
        lightboxImage.src = '';
        lightboxImage.classList.remove('hidden');
      }
      if (lightboxVideo) {
        lightboxVideo.pause();
        lightboxVideo.removeAttribute('src');
        lightboxVideo.classList.add('hidden');
      }
    });

    if (buttons[0]) selectFilter(buttons[0]);
  </script>
</SiteLayout>
